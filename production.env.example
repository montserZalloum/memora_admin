# Production Environment Configuration — Recommended Values
# Copy to .env and adjust for your deployment.
# All values below are tuned for 100k concurrent users with 4 uvicorn workers.

# --- Scaling: Redis Connection Pool ---
# 200 connections per worker × 4 workers = 800 total (Redis default max: 10,000)
REDIS_MAX_CONNECTIONS=200

# --- Scaling: WebSocket Broadcast ---
# Parallel broadcast with semaphore limit. 0=sequential (dev only).
WS_BROADCAST_CONCURRENCY=50

# --- Scaling: Rate Limiter Fail Behavior ---
# false=return 503 when Redis unavailable (prevents unmetered traffic under attack)
RATE_LIMIT_FAIL_OPEN=false

# --- Scaling: Upstream Frappe API Client ---
# Higher timeout for cache-miss hydration storms
FRAPPE_TIMEOUT=10.0
# Larger pool for concurrent hydration requests
FRAPPE_MAX_CONNECTIONS=200
# Keepalive must be <= max_connections
FRAPPE_MAX_KEEPALIVE=50

# --- Rate Limiting (pre-existing) ---
GLOBAL_RATE_LIMIT=100
GLOBAL_RATE_LIMIT_WINDOW=60
REVIEWS_RATE_LIMIT=30
