# Redis Configuration
REDIS_URL=redis://127.0.0.1:13001

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Paths
BITMAP_JSON_PATH=/path/to/sites/your-site/private/memora_bitmaps

# Frappe Integration
FRAPPE_URL=http://localhost:8001
FRAPPE_SITE=your-site.example.com
FRAPPE_API_KEY=your-api-key
FRAPPE_API_SECRET=your-api-secret

# Environment
ENVIRONMENT=production
API_VERSION=v1
PYTHONDONTWRITEBYTECODE=1  # Disable .pyc files in development

# Voucher Configuration
# MUST match voucher_hmac_secret in Frappe site_config.json
VOUCHER_HMAC_SECRET=your-hmac-secret

# Logging
SLOW_REDIS_THRESHOLD_MS=50

REDIS_MAX_CONNECTIONS=200

FRAPPE_MAX_CONNECTIONS=200

PRACTICE_MAPS_DIR=/path/to/sites/your-site/public/files/cdn/practice/maps
