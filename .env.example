# Redis Configuration
# IMPORTANT: Memora uses a DEDICATED Redis instance (port 13001), separate from Frappe cache (port 13000).
# This ensures `bench clear-cache` does not affect game data.
# See README.md "Redis Hardening Deployment Guide" for setup instructions.
REDIS_URL=redis://127.0.0.1:13001

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Paths
BITMAP_JSON_PATH=/home/corex/aurevia-bench/sites/x.conanacademy.com/private/memora_bitmaps

# Frappe Integration
# IMPORTANT: Point to your Frappe bench URL (not production API key!)
FRAPPE_URL=http://localhost:8001
FRAPPE_SITE=x.conanacademy.com
FRAPPE_API_KEY=your-api-key-here
FRAPPE_API_SECRET=your-api-secret-here

# Environment
ENVIRONMENT=development
API_VERSION=v1

# Voucher Configuration
# IMPORTANT: Must match voucher_hmac_secret in Frappe site_config.json
VOUCHER_HMAC_SECRET=your-voucher-hmac-secret-here

# Logging
SLOW_REDIS_THRESHOLD_MS=50
