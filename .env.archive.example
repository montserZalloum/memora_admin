# Archive Executor Environment Configuration
# ============================================
# Copy to /etc/memora-archive.env and fill in real values.
# Source this file in cron: . /etc/memora-archive.env
# Restrict permissions: chmod 600 /etc/memora-archive.env

# ── Database (required) ────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=frappe
DB_PASSWORD=CHANGE_ME
DB_NAME=_a58f3fa42a7ba4ed

# ── Local paths ────────────────────────────────────────────────────────────
# Where Parquet batch directories are staged and published
ARCHIVE_OUTPUT_PATH=/data/memora/archives/
LIVE_OUTPUT_PATH=/data/memora/live/

# Path to the archive_schemas/ directory inside this app
SCHEMA_REGISTRY_PATH=/home/corex/aurevia-bench/apps/memora_admin/archive_schemas

# Structured log output directory
LOG_PATH=/var/log/memora-archive/

# Lock files (prevent concurrent executor runs)
LOCK_FILE=/var/run/memora-archive.lock
LIVE_LOCK_FILE=/var/run/memora-live-sync.lock

# Streaming chunk size (rows per batch, default 50000)
CHUNK_SIZE=50000

# Hours before a Processing job is considered stuck (default 1)
STUCK_TIMEOUT_HOURS=1

# ── SSH / Remote transfer (required for production) ─────────────────────────
# Leave blank to run in export-only mode (no transfer/ingest).
ANALYTICS_SSH_HOST=187.77.93.112
ANALYTICS_SSH_USER=analytics
ANALYTICS_SSH_KEY_PATH=/etc/memora-archive/id_rsa_analytics
ANALYTICS_SSH_PORT=22
ANALYTICS_SSH_TIMEOUT=300

# Remote directories on analytics server
REMOTE_ARCHIVE_PATH=/data/analytics/archives/
REMOTE_LIVE_PATH=/data/analytics/live/

# Remote base path on analytics server (used by both archive executor
# and analytics exporter — dimensions go to /dimensions/, datasets
# go to /datasets/, archives go to /archives/, etc.)
ANALYTICS_REMOTE_PATH=/data/analytics

# ── Analytics CLI (required when SSH is configured) ─────────────────────────
# Path to the memora-analytics binary on the remote server
ANALYTICS_CMD_PATH=/opt/analytics/memora-analytics

# Path to the DuckDB file on the remote server
REMOTE_DUCKDB_PATH=/data/analytics/memora.duckdb

# ── Analytics exporter (fact/dimension dataset export) ──────────────────────
# Local output directory for Parquet + manifest files
ANALYTICS_OUTPUT_PATH=/data/memora/analytics_exports/

# Path to the analytics_exporter/schemas/ directory inside this app
ANALYTICS_SCHEMA_PATH=/home/corex/aurevia-bench/apps/memora_admin/analytics_exporter/schemas

# Structured log output file
ANALYTICS_LOG_PATH=/var/log/memora-archive/analytics_exporter.log

# Export mode: auto (default), full, or incremental
ANALYTICS_MODE=auto

# Streaming chunk size (rows per batch, default 50000)
ANALYTICS_CHUNK_SIZE=50000

# Optional: comma-separated subset of datasets to export (default: all)
# ANALYTICS_DATASETS=dim_player,fact_practice,fact_interaction

# Optional: custom date range for fact_interaction (default: last 30 days)
# ANALYTICS_INTERACTION_FROM=2026-01-01
# ANALYTICS_INTERACTION_TO=2026-03-14
